  59:Core/Src/MCU6050.c **** void MPU6050_Calibrate(void)
  60:Core/Src/MCU6050.c **** {
  61:Core/Src/MCU6050.c ****     uint32_t start = tick_count;
  62:Core/Src/MCU6050.c ****     float sum = 0.0f;
  63:Core/Src/MCU6050.c ****     uint16_t samples = 0;
  64:Core/Src/MCU6050.c ****     
  65:Core/Src/MCU6050.c ****     // Собираем 1000 семплов (~1 секунда)
  66:Core/Src/MCU6050.c ****     while ((uint32_t)(tick_count - start) < 2000) {
  67:Core/Src/MCU6050.c ****         float gz = MPU6050_Read_Yaw_Rate_No_Offset();  // Чтение без вычитания of
  68:Core/Src/MCU6050.c ****         sum += gz;
  69:Core/Src/MCU6050.c ****         samples++;
  70:Core/Src/MCU6050.c ****         
  71:Core/Src/MCU6050.c ****         // Небольшая задержка
  72:Core/Src/MCU6050.c ****         uint32_t wait_start = tick_count;
  73:Core/Src/MCU6050.c ****         while ((uint32_t)(tick_count - wait_start) < 1);  // 1 мс
  74:Core/Src/MCU6050.c ****     }
  75:Core/Src/MCU6050.c ****     
  76:Core/Src/MCU6050.c ****     if (samples > 0) {
  77:Core/Src/MCU6050.c ****         gz_offset = sum / samples;
  78:Core/Src/MCU6050.c ****     }
